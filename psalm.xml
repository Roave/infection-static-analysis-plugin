<?xml version="1.0"?>
<psalm
    xmlns="https://getpsalm.org/schema/config"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
    name="Example Psalm config with recommended defaults"
    errorLevel="1"
>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>

    <projectFiles>
        <directory name="bin"/>
        <directory name="src"/>
        <directory name="test"/>
    </projectFiles>

    <issueHandlers>
        <!-- the #[\Override] annotation is 99.9% useless noise, and we won't waste time with it -->
        <MissingOverrideAttribute errorLevel="suppress"/>
        <!--
        we do a loooooooot of kinky stuff with infection's internals: that's by "design",
        but no way around it for now.
        -->
        <InternalClass errorLevel="suppress"/>
        <InternalMethod errorLevel="suppress"/>
        <!--
        we extend from infection internals, because upstream has no interfaces for
        some symbols.
        -->
        <InvalidExtendClass errorLevel="suppress"/>
    </issueHandlers>
</psalm>
